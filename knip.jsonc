// Knip configuration — whole-tree unused-file / unused-export / unused-
// dependency scan, run as a HARD check by tools/check-knip-dead-code.mjs
// (complete-check step 17). Renamed from knip.json to knip.jsonc (audit
// after 9.7.5) so every exception below can carry its reason — plain JSON
// cannot hold comments, so the old file could never document anything.
//
// Where exceptions live (one place each, never in the check script):
//   - a file/dependency Knip cannot see being used → here, with a reason;
//   - an export kept on purpose → a `/** @public <reason> */` tag at the
//     export itself, so the reason sits next to the code it explains.
{
  "$schema": "https://unpkg.com/knip@5/schema.json",

  "entry": [
    "js/workflow/background.js",
    "dashboard/*.js",
    "matrix/*.js",
    "popup/*.js",
    "privacy/*.js",
    // (10.7.2) uBD's block page — opened by the service worker via tabs.update (js/core/block-page.js), never imported.
    "blocked/*.js",
    "picker/*.js",

    "js/offscreen/compile-filters.js",
    // Loaded as TEXT by compile-filters.js — fetch('./css-compiled.template.js')
    // — never imported, so Knip cannot see it.
    "js/offscreen/css-compiled.template.js",

    // Content scripts: registered by string path through browser.scripting,
    // never imported.
    "js/scripting/*.js",
    "js/security/*.js",
    // (10.6.0) Per-scriptlet custom-rule bodies — one tiny file per deduped @adguard/scriptlets function,
    // generated by tools/build/custom-scriptlets-dispatch.mjs, looked up by js/core/custom-scriptlets.js via
    // SCRIPTLET_NAME_TO_FILE (a name -> path STRING map) and injected with chrome.scripting.executeScript({
    // files }) — same "registered/injected by string path, never imported" shape as js/scripting/*.js above.
    "js/generated/custom-scriptlets/*.js",

    // Loaded by a <script src> tag in every panel's HTML (popup, picker,
    // matrix, privacy inspector, dashboard) — see STYLE_GUIDE_DARK.md's
    // prerequisite note. Knip does not read HTML.
    "js/ui/theme.js",

    "tools/*.mjs",
    // Loaded with `node --import` by tools/verify-build-unchanged.mjs, never
    // imported — a preload that records/replays every build download.
    "tools/lib/fetch-record-replay.mjs",
    // Stylelint's config imports tools/stylelint-plugins/*.mjs.
    ".stylelintrc.mjs"
  ],

  "project": [
    "js/**/*.js",
    "dashboard/**/*.js",
    "matrix/**/*.js",
    "popup/**/*.js",
    "privacy/**/*.js",
    "blocked/**/*.js",
    "picker/**/*.js",
    "tools/**/*.mjs"
  ],

  "ignore": [
    "rulesets/**",
    "vendor/**",
    "lib/**",
    "web_accessible_resources/**",

    // Generated files (rebuilt by the build scripts, never hand-edited).
    "js/scripting/autodeny-snippets.generated.js",
    "js/data/tracker-radar-data.js",

    "tools/data/**"
  ],

  // Command-line tools the check suite runs through node_modules/.bin
  // (tools/check-circular-deps.mjs, check-coverage.mjs, check-depcheck.mjs,
  // check-duplicate-code.mjs), never imported — invisible to Knip.
  "ignoreDependencies": [ "c8", "depcheck", "jscpd", "madge" ],

  // An export used inside its own file is not dead code — its `export`
  // keyword is merely redundant. Only exports used NOWHERE are reported.
  "ignoreExportsUsedInFile": true,

  // Knip's stylelint plugin assumes stylelint plugins are listed as
  // strings; .stylelintrc.mjs passes them as imported modules, and the
  // plugin crashed Knip on every run ("id.startsWith is not a function")
  // before a single file was scanned. Disabled; .stylelintrc.mjs is an
  // entry above instead, which covers the same dependencies.
  "stylelint": false
}
